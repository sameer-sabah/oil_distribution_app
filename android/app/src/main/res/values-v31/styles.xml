<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="LaunchTheme"
        parent="@android:style/Theme.Light.NoTitleBar">

        <!-- نفس صورة بداية التطبيق -->
        <item name="android:windowBackground">
            @drawable/launch_background
        </item>

        <!-- إخفاء أيقونة Android Splash -->
        <item name="android:windowSplashScreenAnimatedIcon">
            @drawable/transparent_splash_icon
        </item>

        <!-- خلفية Android Splash التابعة للنظام بلون البداية الداكن -->
        <item name="android:windowSplashScreenBackground">
            #020B18
        </item>

    </style>

    <style name="NormalTheme"
        parent="@android:style/Theme.Light.NoTitleBar">

        <item name="android:windowBackground">
            @drawable/launch_background
        </item>

    </style>

</resources>