      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'branchManager' || (root.child('users').child(auth.uid).child('role').val() == 'stationManager' || root.child('users').child(auth.uid).child('role').val() == 'station_manager' || root.child('users').child(auth.uid).child('role').val() == 'station') || (root.child('users').child(auth.uid).child('role').val() == 'distributionManager' || root.child('users').child(auth.uid).child('role').val() == 'distribution_manager'))"
