      ".write": true
    },
    "walletTopUpRequests": {
      ".read": true,
      ".write": true
    },
    "advertiserAccounts": {
      ".read": true,
      ".write": true
    },
    "stations": {
      ".read": true,
      "$stationId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && ((!data.exists() && newData.exists() && newData.child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()) || (data.exists() && data.child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val() && (!newData.exists() || newData.child('branchId').val() == data.child('branchId').val())))) || ((root.child('users').child(auth.uid).child('role').val() == 'stationManager' || root.child('users').child(auth.uid).child('role').val() == 'station_manager' || root.child('users').child(auth.uid).child('role').val() == 'station') && root.child('users').child(auth.uid).child('stationId').val() == $stationId))",
        ".validate": "newData.hasChildren(['active', 'approved', 'branchId']) && newData.child('active').isBoolean() && newData.child('approved').isBoolean() && newData.child('branchId').isString()"
      }
    },
