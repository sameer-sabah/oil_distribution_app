        ".read": "auth != null && (data.child('receiverUid').val() == auth.uid || data.child('senderUid').val() == auth.uid)",
        ".write": "auth != null && !data.exists() && newData.exists() && newData.child('senderUid').val() == auth.uid && ((root.child('users').child(auth.uid).child('role').val() == 'admin' && root.child('users').child(newData.child('receiverUid').val()).child('role').val() == 'branchManager') || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && (root.child('users').child(newData.child('receiverUid').val()).child('role').val() == 'admin' || (root.child('users').child(newData.child('receiverUid').val()).child('role').val() == 'stationManager' && root.child('users').child(newData.child('receiverUid').val()).child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()))) || ((root.child('users').child(auth.uid).child('role').val() == 'stationManager' || root.child('users').child(auth.uid).child('role').val() == 'station_manager' || root.child('users').child(auth.uid).child('role').val() == 'station') && root.child('users').child(newData.child('receiverUid').val()).child('role').val() == 'branchManager' && root.child('users').child(newData.child('receiverUid').val()).child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()))",
        ".validate": "newData.hasChildren(['id', 'senderUid', 'senderName', 'senderRole', 'receiverUid', 'receiverName', 'receiverRole', 'branchId', 'stationId', 'subject', 'message', 'read', 'createdAt']) && newData.child('id').isString() && newData.child('senderUid').isString() && newData.child('senderName').isString() && newData.child('senderRole').isString() && newData.child('receiverUid').isString() && newData.child('receiverName').isString() && newData.child('receiverRole').isString() && newData.child('branchId').isString() && newData.child('stationId').isString() && newData.child('subject').isString() && newData.child('message').isString() && newData.child('read').isBoolean() && newData.child('createdAt').isString()",
        "read": {
          ".write": "auth != null && data.parent().child('receiverUid').val() == auth.uid",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "commercialAds": {
      ".read": "auth != null",
      "$adId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid && newData.child('ownerUid').val() == data.child('ownerUid').val()))",
        "views": {
          ".write": "auth != null"
        },
        "clicks": {
          ".write": "auth != null"
        },
        "calls": {
          ".write": "auth != null"
        },
        "whatsappClicks": {
          ".write": "auth != null"
        },
        "mapClicks": {
          ".write": "auth != null"
        }
      }
    },
    "commercialServices": {
      ".read": "auth != null",
      "$serviceId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (!data.exists() && newData.child('ownerUid').val() == auth.uid) || (data.exists() && data.child('ownerUid').val() == auth.uid && newData.child('ownerUid').val() == data.child('ownerUid').val()))",
        "views": {
          ".write": "auth != null"
        },
        "clicks": {
          ".write": "auth != null"
        },
        "calls": {
          ".write": "auth != null"
        },
        "whatsappClicks": {
          ".write": "auth != null"
        },
        "mapClicks": {
          ".write": "auth != null"
        }
      }
    },
    "commercialRequests": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'",
      "$requestId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (!data.exists() && newData.child('ownerUid').val() == auth.uid))"
      }
    },
    "commercialPayments": {
      ".read": "auth != null",
      "$paymentId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (!data.exists() && newData.child('ownerUid').val() == auth.uid))"
      }
    },
