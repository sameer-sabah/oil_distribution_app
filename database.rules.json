      "$stationId": {
        ".write": true
      }
    },
    "users": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || ((root.child('users').child(auth.uid).child('role').val() == 'branchManager' || (root.child('users').child(auth.uid).child('role').val() == 'stationManager' || root.child('users').child(auth.uid).child('role').val() == 'station_manager' || root.child('users').child(auth.uid).child('role').val() == 'station')) && query.orderByChild == 'branchId' && query.equalTo == root.child('users').child(auth.uid).child('branchId').val()))",
      ".indexOn": [
        "role",
        "branchId",
        "stationId"
      ],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && root.child('users').child($uid).child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()) || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && root.child('users').child($uid).child('role').val() == 'admin') || ((root.child('users').child(auth.uid).child('role').val() == 'stationManager' || root.child('users').child(auth.uid).child('role').val() == 'station_manager' || root.child('users').child(auth.uid).child('role').val() == 'station') && root.child('users').child($uid).child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()))",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.uid == $uid || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && !data.exists() && newData.child('role').val() == 'stationManager' && newData.child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()))",
        ".validate": "newData.hasChildren(['fullName', 'username', 'email', 'role', 'active'])",
        "role": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && !data.parent().exists() && newData.val() == 'stationManager'))"
        },
        "branchId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.uid == $uid || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && !data.parent().exists() && newData.val() == root.child('users').child(auth.uid).child('branchId').val()))"
        },
        "stationId": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.uid == $uid || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && !data.parent().exists()))"
        },
        "active": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || auth.uid == $uid || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && !data.parent().exists()))"
        },
        "password": {
          ".write": false
        }
      }
    },
    "deviceTokens": {
      ".read": false,
      "citizens": {
        ".read": "auth != null",
        "$deviceId": {
          ".write": "auth != null"
        }
      },
      "$type": {
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')",
          ".write": "auth != null && (auth.uid == $uid || root.child('users').child(auth.uid).child('role').val() == 'admin')"
        }
      }
    },
    "whatsappMessages": {
      ".read": false,
      "$messageId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && newData.child('branchId').val() == root.child('users').child(auth.uid).child('branchId').val()))",
        ".validate": "newData.hasChildren(['id', 'phone', 'message', 'type', 'stationId', 'stationName', 'username', 'createdAt', 'sent']) && newData.child('id').isString() && newData.child('phone').isString() && newData.child('message').isString() && newData.child('type').isString() && newData.child('stationId').isString() && newData.child('stationName').isString() && newData.child('username').isString() && newData.child('createdAt').isString() && newData.child('sent').isBoolean()"
      }
    },
    "appInstallations": {
      ".read": "auth != null",
