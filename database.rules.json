      "$branchId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'admin' || (root.child('users').child(auth.uid).child('role').val() == 'branchManager' && root.child('users').child(auth.uid).child('branchId').val() == $branchId))"
      }
    },
    "governorates": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'admin'"
    },
    "paymentMethods": {
