      "$requestId": {
        ".write": "auth != null && ((!data.exists() && newData.child('status').val() == 'pending') || root.child('users').child(auth.uid).child('role').val() == 'admin' || root.child('users').child(auth.uid).child('role').val() == 'branchManager')"
      }
